VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# Optional: публичный адрес сайта для абсолютных URL изображений в email.
# Пример: https://koryaga.by
VITE_PUBLIC_SITE_URL=

# Public Supabase values. Safe for the browser when RLS is enabled.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Server-only Vercel variables. Never prefix these with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
TELEGRAM_BOT_TOKEN=123456:ABCDEF
TELEGRAM_ORDER_CHAT_ID=123456789
TELEGRAM_ADMIN_IDS=123456789

# Local development only. Use the same random value in both variables.
ADMIN_DEV_KEY=
VITE_ADMIN_DEV_KEY=
